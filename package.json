{
  "name": "@mengshu/core",
  "version": "1.0.7",
  "description": "Local-first memory middleware for multi-product Agent Runtimes with governed recall and capture",
  "type": "module",
  "license": "MIT",
  "homepage": "https://github.com/jyyconrad/mengshu#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jyyconrad/mengshu.git"
  },
  "bugs": {
    "url": "https://github.com/jyyconrad/mengshu/issues"
  },
  "keywords": [
    "mengshu",
    "memory",
    "mcp",
    "agent",
    "openclaw",
    "codex"
  ],
  "main": "./dist/packages/core/src/index.js",
  "types": "./dist/packages/core/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/packages/core/src/index.d.ts",
      "import": "./dist/packages/core/src/index.js"
    },
    "./api": {
      "types": "./dist/packages/api/src/index.d.ts",
      "import": "./dist/packages/api/src/index.js"
    },
    "./mcp": {
      "types": "./dist/packages/mcp/src/index.d.ts",
      "import": "./dist/packages/mcp/src/index.js"
    },
    "./ui": {
      "types": "./dist/packages/ui/src/index.d.ts",
      "import": "./dist/packages/ui/src/index.js"
    },
    "./openclaw": {
      "types": "./dist/plugins/openclaw/src/index.d.ts",
      "import": "./dist/plugins/openclaw/src/index.js"
    },
    "./runtime": {
      "types": "./dist/runtime.d.ts",
      "import": "./dist/runtime.js"
    },
    "./config": {
      "types": "./dist/config.d.ts",
      "import": "./dist/config.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "openclaw.plugin.json",
    "README.md",
    "docs/README.md",
    "docs/api",
    "docs/guides",
    "docs/architecture/system-architecture.md",
    "docs/architecture/technology-stack.md",
    "docs/design/memory-system-unified-design.md",
    "docs/design/schema.md",
    "config.example.json",
    "config/*.example.json",
    ".agents/plugins/marketplace.json",
    "scripts/sql",
    "scripts/pack-codex-marketplace.mjs",
    "plugins/codex/.codex-plugin/plugin.json",
    "plugins/codex/.mcp.json",
    "plugins/codex/mcp/server.mjs",
    "plugins/codex/skills",
    "plugins/codex/sources",
    "plugins/codex/README.md",
    "plugins/openclaw/openclaw.plugin.json",
    "plugins/openclaw/README.md"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@lancedb/lancedb": "^0.26.2",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@sinclair/typebox": "0.34.48",
    "@supabase/supabase-js": "^2.108.2",
    "commander": "^10.0.1",
    "glob": "^10.4.5",
    "ignore": "^5.3.2",
    "md5": "^2.3.0",
    "nanoid": "^5.1.16",
    "openai": "^6.45.0",
    "p-limit": "^6.1.0",
    "p-retry": "^6.2.0",
    "pg": "^8.16.0",
    "seedrandom": "^3.0.5",
    "undici": "^6.28.1"
  },
  "devDependencies": {
    "@types/node": "^25.3.1",
    "@types/pg": "^8.15.4",
    "@types/seedrandom": "^3.0.8",
    "@vitest/coverage-v8": "^4.1.8",
    "dotenv": "^17.3.1",
    "openclaw": "*",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vitest": "^4.0.18"
  },
  "peerDependencies": {
    "openclaw": "*"
  },
  "peerDependenciesMeta": {
    "openclaw": {
      "optional": true
    }
  },
  "overrides": {
    "@hono/node-server@<=1.19.14": "1.19.15",
    "hono@<=4.12.33": "4.12.34",
    "brace-expansion@>=2.0.0 <2.1.4": "2.1.4",
    "fast-uri@>=3.0.0 <3.1.5": "3.1.5",
    "fast-xml-parser@<5.7.0": "5.7.0",
    "ip-address@<=10.3.0": "10.5.0",
    "ws@>=8.0.0 <8.21.0": "8.21.0",
    "body-parser@>=2.0.0 <2.3.0": "2.3.0"
  },
  "bin": {
    "ms": "./dist/bin/ms.js",
    "mengshu": "./dist/bin/ms.js"
  },
  "scripts": {
    "clean": "rm -rf dist",
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "postbuild": "chmod +x dist/bin/ms.js",
    "prepack": "npm run version:check && npm run build",
    "pack:dry-run": "npm pack --dry-run",
    "pack:codex": "node scripts/pack-codex-marketplace.mjs",
    "version:check": "node scripts/check-version-consistency.mjs",
    "test": "vitest run",
    "test:live": "MENGSHU_RUN_LIVE_TESTS=1 vitest run index.test.ts hybrid-integration.test.ts",
    "test:production-gate": "node -e \"if (process.env.MENGSHU_RUN_LIVE_TESTS !== '1') { console.error('test:production-gate requires MENGSHU_RUN_LIVE_TESTS=1'); process.exit(1) }\" && vitest run tests/live/postgres-v9-runtime.e2e.test.ts tests/live/production-rest-runtime-eval.e2e.test.ts tests/live/postgres-authoritative-graph-reuse.e2e.test.ts tests/live/postgres-entity-alias-lifecycle.e2e.test.ts",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "eval:quick": "tsx tests/eval/runners/quick-eval.ts",
    "eval:g0:round1": "tsx tests/eval/runners/run-g0-evaluation.ts --round 1 --cache cold",
    "eval:g0:round2": "tsx tests/eval/runners/run-g0-evaluation.ts --round 2 --cache warm",
    "eval:g0:finalize": "tsx tests/eval/runners/finalize-g0-evaluation.ts",
    "eval:rag-multi:sync": "python3 tests/eval/public/tools/sync-rag-multi-corpus.py",
    "eval:kb-pilot:mengshu": "tsx tests/eval/public/kb-pilot/mengshu-e2e.ts",
    "eval:private:prepare": "tsx tests/eval/private/tools/build-private-v1.ts",
    "eval:selfbuilt:prepare": "tsx tests/eval/selfbuilt/tools/prepare-selfbuilt.ts",
    "eval:selfbuilt:round1": "tsx tests/eval/selfbuilt/tools/run-selfbuilt-evaluation.ts --round 1 --cache cold",
    "eval:selfbuilt:round2": "tsx tests/eval/selfbuilt/tools/run-selfbuilt-evaluation.ts --round 2 --cache warm",
    "eval:selfbuilt:finalize": "tsx tests/eval/selfbuilt/tools/finalize-selfbuilt-evaluation.ts",
    "migrate:topic-tree": "tsx scripts/operator-topic-tree-migrate.ts",
    "migrate:history": "tsx scripts/operator-history-rebuild.ts"
  },
  "openclaw": {
    "extensions": [
      "./dist/plugins/openclaw/src/index.js"
    ]
  }
}
